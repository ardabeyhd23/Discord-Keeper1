DISCORD_BOT_TOKEN=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODERATION_MODEL=llama-3.3-70b-versatile
# Görsel moderasyonu için Groq'un görsel destekli modeli.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
WELCOME_DM_ENABLED=true
# Boş bırakılırsa onaylanan öneri, önerinin gönderildiği kanalda yayınlanır.
SUGGESTION_CHANNEL_ID=
PORT=8080
FRARDA_OWNER_ID=
# Mağaza duyuruları için Discord webhook'u secret olarak eklenir; URL'yi repoya yazma.
SHOP_WEBHOOK_URL=
# Mağaza DIŞI komutlar için kanal webhook'ları bot tarafından otomatik oluşturulur. Her kanalda Webhook'ları Yönet yetkisi gerekir.

# Render PostgreSQL connection string
DATABASE_URL=

# Web shop OAuth
DISCORD_CLIENT_ID=1535760848407232603
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret
FR_SHOP_ACTIVITY_URL=https://your-shop-domain.example.com
FR_SHOP_OAUTH_REDIRECT_URI=https://your-bot-domain.example.com/api/shop/auth/callback
# Optional: force the web shop to one Discord guild
FR_SHOP_GUILD_ID=
